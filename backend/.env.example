# Copy to .env and fill in. Use TEST MODE keys only: https://dashboard.stripe.com/test/apikeys
# The server refuses to start with a live key unless ALLOW_LIVE_KEYS=true.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Printed by `stripe listen` ("Your webhook signing secret is whsec_...").
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Only needed if your Connect endpoint has its own secret (it does in the Dashboard; the CLI uses one secret for both).
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace_me

PORT=4242
# Where Stripe sends providers after Connect onboarding. Must be HTTPS in live mode.
PUBLIC_URL=http://localhost:4242

MERCHANT_DISPLAY_NAME=Booking Deposits Demo
MERCHANT_COUNTRY=US
CURRENCY=usd
PLATFORM_FEE_PERCENT=10

# `auto` providers hold the deposit only for appointments starting within this many hours.
# Online card holds last about 7 days (Visa merchant-initiated ones less), so keep a margin.
HOLD_WINDOW_HOURS=144
# How long an unpaid booking keeps its slot.
PAYMENT_WINDOW_MINUTES=15

# Demo only: lets the provider tools mark a no-show or attendance before the slot starts,
# so you can try those flows without waiting. Set to false (or remove) in production.
DEMO_ALLOW_EARLY_OUTCOMES=true

DATABASE_PATH=./data/dev.sqlite
